# Production Environment Configuration for Tamkeen Vite Frontend (Ubuntu VPS)
# Target File Path: tamkeen/.env.production

# Backend REST API relative base path (proxied by Nginx to http://127.0.0.1:5000/api)
VITE_BACKEND_API_URL=/api

# Socket.IO endpoint (empty string allows client to default to current origin with path /socket.io/)
VITE_SOCKET_URL=

# Public media & uploads prefix (served directly by Nginx /uploads/)
VITE_PREFIX_URL=/uploads
